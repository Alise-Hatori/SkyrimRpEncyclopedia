<Window x:Class="SkyrimRpEncyclopedia.MetadataSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Теги и флаги"
        Width="700"
        Height="520"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NordVoidBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/ThemeDefaults.xaml"/>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Теги и флаги" Style="{StaticResource DialogHeading}"/>
            <TextBlock Text="Выберите существующие метки для статьи. Новые можно создать в разделе «Управление данными»."
                       Style="{StaticResource DialogLead}"/>
            <TextBlock x:Name="RetainedMetadataHint" Visibility="Collapsed"
                       Text="Метки, отсутствующие в справочнике, сохранятся. Чтобы удалить их, измените поля статьи."
                       Style="{StaticResource DialogLead}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Теги" Style="{StaticResource DialogFieldLabel}"/>
                <ListBox x:Name="TagsListBox" SelectionMode="Multiple" DisplayMemberPath="DisplayName"/>
                <TextBlock x:Name="TagsEmptyMessage" Visibility="Collapsed"
                           Text="В этой пользовательской базе ещё нет тегов. Создайте их в «Управление данными» или введите в поле статьи."
                           Style="{StaticResource DialogLead}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Флаги" Style="{StaticResource DialogFieldLabel}"/>
                <ListBox x:Name="FlagsListBox" SelectionMode="Multiple" DisplayMemberPath="DisplayName"/>
                <TextBlock x:Name="FlagsEmptyMessage" Visibility="Collapsed"
                           Text="В этой пользовательской базе ещё нет флагов. Создайте их в «Управление данными» или введите в поле статьи."
                           Style="{StaticResource DialogLead}"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource DialogSecondaryButton}" Click="Cancel_Click"/>
            <Button Content="Применить" Style="{StaticResource DialogPrimaryButton}" Margin="10,0,0,0" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
