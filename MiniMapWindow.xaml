<Window x:Class="SkyrimRpEncyclopedia.MiniMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SkyrimRpEncyclopedia.Views"
        Title="Skyrim RP — Мини-карта"
        Width="280" Height="280" MinWidth="180" MinHeight="180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/ThemeDefaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="MiniMapBronzeBrush" Color="#D7B46A"/>
            <SolidColorBrush x:Key="MiniMapDarkBronzeBrush" Color="#523B22"/>
            <SolidColorBrush x:Key="MiniMapSurfaceBrush" Color="#E6111922"/>
            <Style x:Key="MiniMapActionButton" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="MapSurface">
        <views:MapView x:Name="MiniMap"/>
        <Ellipse Stroke="{StaticResource MiniMapBronzeBrush}" StrokeThickness="4" Fill="Transparent" IsHitTestVisible="False"/>
        <Ellipse Stroke="{StaticResource MiniMapDarkBronzeBrush}" StrokeThickness="10" Opacity="0.75" IsHitTestVisible="False"/>
        <Border Width="150" Height="28" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,7,0,0"
                Background="{StaticResource MiniMapSurfaceBrush}" BorderBrush="{StaticResource MiniMapBronzeBrush}" BorderThickness="1" CornerRadius="12"
                MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
            <DockPanel LastChildFill="False">
                <Button Content="−" Style="{StaticResource MiniMapActionButton}" Click="DecreaseSize_Click" ToolTip="Уменьшить мини-карту"/>
                <TextBlock Width="62" Text="Мини-карта" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource NordSilverBrush}" FontSize="11" FontFamily="{StaticResource NordDisplayFont}"/>
                <Button Content="+" Style="{StaticResource MiniMapActionButton}" Click="IncreaseSize_Click" ToolTip="Увеличить мини-карту"/>
                <Button Content="×" Style="{StaticResource MiniMapActionButton}" Click="Hide_Click" ToolTip="Скрыть мини-карту"/>
            </DockPanel>
        </Border>
        <Border Width="150" Height="24" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                Background="{StaticResource MiniMapSurfaceBrush}" BorderBrush="{StaticResource MiniMapBronzeBrush}" BorderThickness="1" CornerRadius="10">
            <StackPanel Orientation="Horizontal" Margin="7,0">
                <TextBlock Text="Прозрачность" Foreground="{StaticResource NordSilverBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="OpacitySlider" Width="72" Minimum="0.35" Maximum="1" Value="0.95" ValueChanged="OpacitySlider_ValueChanged"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
