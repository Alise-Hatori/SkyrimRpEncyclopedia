<Window x:Class="SkyrimRpEncyclopedia.MetadataPresetsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Готовые наборы" Width="760" Height="740" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{StaticResource NordVoidBrush}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Assets/Theme/DarkSkyrim/MetadataStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,15"><TextBlock x:Name="Heading" Text="Готовые наборы" Style="{StaticResource DialogHeading}" FontSize="27"/><TextBlock Text="Добавляются только выбранные новые элементы. Статьи и существующие метки не меняются." Style="{StaticResource DialogLead}"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="SelectAllButton" Content="Выбрать всё" Style="{StaticResource DialogSecondaryButton}" Padding="12,0" Click="SelectAll_Click"/><Button x:Name="ClearSelectionButton" Content="Снять выбор" Style="{StaticResource DialogSecondaryButton}" Padding="12,0" Margin="8,0,0,0" Click="ClearSelection_Click"/></StackPanel><TextBlock x:Name="CountText" Foreground="#9CBACB" FontSize="11" TextWrapping="Wrap" Margin="15,0,0,0" VerticalAlignment="Center"/></DockPanel>
  <ListBox x:Name="PresetList" Grid.Row="2" Background="#101D28" BorderBrush="#2B4558" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="13" Foreground="#9BCADD" Margin="12,16,0,8" FontWeight="SemiBold"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,3"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay}" IsEnabled="{Binding CanSelect}" HorizontalContentAlignment="Stretch" Padding="8,6">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Image}" Width="24" Height="24" VerticalAlignment="Top" Margin="0,3,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Preset.Name}" FontSize="14" Foreground="#E2E8E9" TextWrapping="Wrap"/><TextBlock Text="{Binding Preset.Description}" Foreground="#92ABBB" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding ExistingLabel}" Foreground="#9CC5C2" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid>
   </CheckBox></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock Grid.Row="3" x:Name="ResultText" Foreground="#B0D4E4" TextWrapping="Wrap" Margin="0,12,0,12" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource DialogSecondaryButton}" Padding="12,0" Click="Cancel_Click"/><Button x:Name="AddButton" Content="Добавить выбранные" Style="{StaticResource DialogPrimaryButton}" Padding="14,0" MinWidth="190" Margin="8,0,0,0" IsEnabled="False" Click="Add_Click"/></StackPanel>
 </Grid>
</Window>
