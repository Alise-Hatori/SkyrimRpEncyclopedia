<UserControl x:Class="SkyrimRpEncyclopedia.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="View_SizeChanged" Background="#090D12">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/GraphStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid x:Name="AtlasRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource AtlasPanel}" CornerRadius="5,5,0,0" Padding="18,14">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,24,8">
                        <TextBlock Text="АТЛАС ЗНАНИЙ" FontSize="25" Style="{StaticResource AtlasHeading}"/>
                        <TextBlock Text="SKYRIM · СВЯЗИ И ИСТОРИИ" Style="{StaticResource AtlasLabel}" FontSize="10" Foreground="{StaticResource AtlasGoldBrush}" Margin="1,5,0,0"/>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <ComboBox x:Name="ModeBox" Width="185" Margin="0,0,8,6" SelectionChanged="Mode_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="Исследование"/>
                            <ComboBoxItem Content="Полная карта"/>
                        </ComboBox>
                        <Button x:Name="CancelButton" Content="Отменить загрузку" Click="Cancel_Click" Style="{StaticResource AtlasAction}" IsEnabled="False"/>
                        <Button x:Name="FiltersButton" Content="Фильтры" Click="Filters_Click" Style="{StaticResource AtlasAction}"/>
                        <Button x:Name="DetailsButton" Content="Сведения" Click="Details_Click" Style="{StaticResource AtlasAction}"/>
                        <Button x:Name="ResetButton" Content="Сбросить вид" Click="Refresh_Click" Style="{StaticResource AtlasAction}"/>
                        <Button x:Name="BackButton" Content="В каталог" Click="Back_Click" Style="{StaticResource AtlasPrimaryAction}"/>
                    </WrapPanel>
                </WrapPanel>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource AtlasSearch}" Padding="10,8" FontSize="14" Margin="0,0,8,0"
                             ToolTip="Поиск только по названию, первые 20 результатов." KeyDown="Search_KeyDown" TextChanged="Search_Changed"/>
                    <Button x:Name="SearchButton" Grid.Column="1" Content="Найти" Click="Search_Click" Style="{StaticResource AtlasPrimaryAction}" Margin="0"/>
                </Grid>
                <TextBlock Text="Поиск по названию · read-only · выберите результат и начните исследование" Style="{StaticResource AtlasLabel}"
                           Foreground="{StaticResource NordMutedSilverBrush}" FontSize="11" Margin="0,7,0,0"/>
                <ListBox x:Name="SearchResults" MaxHeight="140" Background="#101820" Foreground="#B8C6CD" Margin="0,8,0,0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"/>
                <Button Content="Исследовать выбранный результат" Click="SearchResult_Click" Style="{StaticResource AtlasAction}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="FiltersPanel" Grid.Column="0" Width="210" Style="{StaticResource AtlasPanel}" Margin="8,8,0,8" Panel.ZIndex="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="Область исследования" Style="{StaticResource AtlasHeading}"/>
                        <TextBlock Text="ИСТОЧНИКИ" Foreground="{StaticResource AtlasGoldBrush}" Style="{StaticResource AtlasLabel}" FontSize="10" Margin="0,20,0,8"/>
                        <CheckBox x:Name="ShowOfficialCheckBox" Content="Официальный архив" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowMvpCheckBox" Content="Knowledge / MVP" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowPersonalCheckBox" Content="Личные материалы" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
                        <Border Height="1" Background="{StaticResource AtlasEdgeBrush}" Margin="0,16"/>
                        <TextBlock Text="ГРУППЫ СУЩНОСТЕЙ" Foreground="{StaticResource AtlasGoldBrush}" Style="{StaticResource AtlasLabel}" FontSize="10" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowCharactersCheckBox" Content="Персонажи" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowPlacesCheckBox" Content="Локации" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowFactionsCheckBox" Content="Фракции" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowQuestsCheckBox" Content="Квесты" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowItemsCheckBox" Content="Предметы" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowCreaturesCheckBox" Content="Существа" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowRacesCheckBox" Content="Расы" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowSpellsCheckBox" Content="Заклинания" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowReligionCheckBox" Content="Боги и даэдра" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
<CheckBox x:Name="ShowOtherCheckBox" Content="Прочее" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" Style="{StaticResource AtlasCheckBox}"/>
                        <TextBlock Text="Фильтры работают по загруженным данным без повторного SQL." Style="{StaticResource AtlasLabel}" FontSize="11" Foreground="{StaticResource NordMutedSilverBrush}" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="MapSurface" Grid.Column="1" Style="{StaticResource AtlasPanel}" Background="{StaticResource AtlasMapBrush}" Margin="8">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Rectangle Fill="{StaticResource AtlasStoneTexture}" Opacity="0.06" IsHitTestVisible="False"/>
                    <!-- Decorative compass only: no invented data nodes or edges. -->
                    <Viewbox Width="300" Height="300" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Opacity="0.16" IsHitTestVisible="False">
                        <Canvas Width="300" Height="300">
                            <Ellipse Width="270" Height="270" Canvas.Left="15" Canvas.Top="15" Stroke="{StaticResource AtlasGoldBrush}" StrokeThickness="1"/>
                            <Ellipse Width="240" Height="240" Canvas.Left="30" Canvas.Top="30" Stroke="{StaticResource NordBlueBrush}" StrokeThickness="1" StrokeDashArray="2,8"/>
                            <Path Data="M150,0 L162,130 L300,150 L162,170 L150,300 L138,170 L0,150 L138,130 Z" Stroke="{StaticResource AtlasGoldBrush}" StrokeThickness="1"/>
                            <Path Data="M45,45 L135,140 M255,45 L165,140 M45,255 L135,160 M255,255 L165,160" Stroke="{StaticResource NordBlueBrush}" StrokeThickness="1"/>
                        </Canvas>
                    </Viewbox>
                    <Grid x:Name="GraphViewport" Visibility="Collapsed" ClipToBounds="True" Background="Transparent"
                          PreviewMouseWheel="Viewport_Wheel" MouseDown="Viewport_Down" MouseMove="Viewport_Move"
                          MouseUp="Viewport_Up" LostMouseCapture="Viewport_LostCapture" SizeChanged="Viewport_Resize">
                        <Canvas x:Name="GraphCanvas" Width="1100" Height="800" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                    <ScrollViewer x:Name="StateScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22">
                        <StackPanel x:Name="StateContent" VerticalAlignment="Center" MaxWidth="470" Margin="0,140,0,30">
                            <TextBlock Text="ПУТИ СЕВЕРНОГО АРХИВА" Style="{StaticResource AtlasLabel}" Foreground="{StaticResource AtlasGoldBrush}" FontSize="11" TextAlignment="Center"/>
                            <TextBlock x:Name="StateTitle" Style="{StaticResource AtlasHeading}" FontSize="25" TextAlignment="Center" Margin="0,18,0,14"/>
                            <Border Height="1" Width="80" Background="{StaticResource AtlasGoldBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <TextBlock x:Name="StateDescription" Style="{StaticResource AtlasLabel}" FontSize="14" TextAlignment="Center" LineHeight="23"/>
                            <ProgressBar x:Name="StateProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource NordBlueBrush}" Margin="0,20"/>
                            <Border Style="{StaticResource AtlasPanel}" Padding="12" Margin="0,25,0,0">
                                <TextBlock Text="Загружается только выбранное окружение. Неразрешённые ссылки не отображаются как связи." Style="{StaticResource AtlasLabel}" Foreground="{StaticResource NordMutedSilverBrush}" FontSize="11" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="10,4" Background="#DD0C1520">
                        <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" Style="{StaticResource AtlasAction}"/>
                        <TextBlock x:Name="ZoomText" Text="100%" Style="{StaticResource AtlasLabel}" VerticalAlignment="Center" Margin="3,0,9,6"/>
                        <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click" Style="{StaticResource AtlasAction}"/>
                        <Button x:Name="ZoomResetButton" Content="100%" Click="ZoomReset_Click" Style="{StaticResource AtlasAction}"/>
                        <Button x:Name="FitButton" Content="Вписать карту" Click="Fit_Click" Style="{StaticResource AtlasAction}"/>
                    </WrapPanel>
                </Grid>
            </Border>
            <Border x:Name="DetailsPanel" Grid.Column="2" Width="250" Style="{StaticResource AtlasPanel}" Margin="0,8,8,8" Panel.ZIndex="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18">
                        <TextBlock Text="Выбранная сущность" Style="{StaticResource AtlasHeading}"/>
                        <Border Height="1" Background="{StaticResource AtlasGoldBrush}" Opacity="0.6" Margin="0,16"/>
                        <TextBlock x:Name="SelectedTitle" Text="Сущность не выбрана" Style="{StaticResource AtlasHeading}" FontSize="20"/>
                        <TextBlock x:Name="SelectedCategory" Text="Тип и категории появятся после выбора" Style="{StaticResource AtlasLabel}" Margin="0,12,0,8"/>
                        <TextBlock x:Name="SelectedSource" Text="Источник не выбран" Foreground="{StaticResource NordBlueBrush}" Style="{StaticResource AtlasLabel}" FontSize="11"/>
                        <Button x:Name="OpenArticleButton" Content="Открыть статью" Click="OpenArticle_Click" IsEnabled="False" Style="{StaticResource AtlasPrimaryAction}" Margin="0,20,0,12"/>
                        <TextBlock Text="Соседей в порции" Style="{StaticResource AtlasLabel}"/>
                        <ComboBox x:Name="BatchBox" Margin="0,6,0,10"/>
                        <Button x:Name="ExpandButton" Content="Раскрыть ещё связи" Click="Expand_Click" IsEnabled="False" Style="{StaticResource AtlasAction}"/>
                        <Button x:Name="CenterSelectedButton" Content="Заменить центральный узел" Click="CenterSelected_Click" IsEnabled="False" Style="{StaticResource AtlasAction}"/>
                        <TextBlock x:Name="SelectionNote" Text="Щелчок выбирает узел. Статья открывается отдельным действием." Style="{StaticResource AtlasLabel}" Foreground="{StaticResource NordMutedSilverBrush}" FontSize="12"/>
                        <Border Height="1" Background="{StaticResource AtlasEdgeBrush}" Margin="0,22"/>
                        <TextBlock Text="СВЯЗИ И ОСНОВАНИЯ" Foreground="{StaticResource AtlasGoldBrush}" Style="{StaticResource AtlasLabel}" FontSize="10"/>
                        <TextBlock Text="Направление записи, исходный тип и описание. Related не означает дружбу, вражду или мотив." Style="{StaticResource AtlasLabel}" FontSize="12" Margin="0,12,0,0"/>
                        <TextBlock x:Name="RelationNotes" Style="{StaticResource AtlasLabel}" FontSize="11" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource AtlasPanel}" CornerRadius="0,0,5,5" Padding="14,9">
            <WrapPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource AtlasLabel}" Foreground="{StaticResource NordBlueBrush}" Margin="0,0,24,0"/>
                <TextBlock x:Name="CountText" Text="Узлы: 0 · Связи: 0" Style="{StaticResource AtlasLabel}" Margin="0,0,24,0"/>
                <TextBlock x:Name="LimitText" Text="Исследование · выберите сущность · панорама: средняя кнопка или пустая область" Style="{StaticResource AtlasLabel}" Foreground="{StaticResource NordMutedSilverBrush}" FontSize="11"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
