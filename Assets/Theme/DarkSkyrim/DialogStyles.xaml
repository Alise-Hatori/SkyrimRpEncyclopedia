<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/ThemeDefaults.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Visual-only building blocks for modal archive windows. -->
    <Style x:Key="DialogHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NordBlueGlowBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NordDisplayFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="DialogLead" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NordMutedSilverBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="DialogFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="DialogSection" TargetType="Border" BasedOn="{StaticResource NordPanelStyle}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource NordPrimaryButton}">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Height" Value="36"/>
    </Style>
    <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Height" Value="36"/>
    </Style>
    <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource NordDangerButton}">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Height" Value="36"/>
    </Style>
</ResourceDictionary>
