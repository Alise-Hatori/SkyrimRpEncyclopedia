<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Import this dictionary into normal application windows/views. Do not merge it at App level: the overlay intentionally remains independent. -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource NordBodyFont}"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource NordActionButton}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource NordSearchBox}"/>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource NordRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordMutedSilverBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource NordPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource NordHoverBrush}"/><Setter Property="Foreground" Value="{StaticResource NordBlueGlowBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="#0B1219"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordMutedSilverBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource NordHoverBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17485C"/><Setter Property="Foreground" Value="{StaticResource NordBlueGlowBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource NordPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordMutedSilverBrush}"/>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="Background" Value="{StaticResource NordRaisedBrush}"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <!-- High-contrast context menus for ordinary application windows. Overlay keeps its own local menu theme. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#101922"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordBlueBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="#101922"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="Padding" Value="13,8,28,8"/>
        <Setter Property="MinWidth" Value="190"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#1E5064"/><Setter Property="Foreground" Value="{StaticResource NordBlueGlowBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource NordDisabledBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource NordScrollViewer}"/>
    <Style TargetType="Separator"><Setter Property="Background" Value="{StaticResource NordMutedSilverBrush}"/><Setter Property="Opacity" Value="0.55"/></Style>

    <!-- Reusable archive content: used by article, note and event views without changing their commands. -->
    <Style x:Key="NordArticleCard" TargetType="Border" BasedOn="{StaticResource NordPanelStyle}">
        <Setter Property="Background" Value="#182531"/>
        <Setter Property="BorderBrush" Value="#415767"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#020609" BlurRadius="9" ShadowDepth="2" Opacity="0.35"/></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#8CCEE4"/>
                <Setter Property="Background" Value="#1C2D3A"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NordArticleTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F0DFC4"/>
        <Setter Property="FontFamily" Value="{StaticResource NordDisplayFont}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NordMetadataText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NordMutedSilverBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="NordOpenButton" TargetType="Button" BasedOn="{StaticResource NordPrimaryButton}">
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinWidth" Value="106"/>
        <Setter Property="Height" Value="34"/>
    </Style>
      <Style x:Key="NordDangerButton" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
        <Setter Property="Background" Value="#4A2930"/>
        <Setter Property="BorderBrush" Value="#B86A70"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Height" Value="34"/>
      </Style>
      <Style x:Key="NordSourceBadge" TargetType="Border">
          <Setter Property="Padding" Value="9,3"/>
          <Setter Property="CornerRadius" Value="10"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="HorizontalAlignment" Value="Left"/>
          <Setter Property="Margin" Value="0,7,0,6"/>
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#020609" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/></Setter.Value></Setter>
      </Style>
      <Style x:Key="NordOfficialSourceBadge" TargetType="Border" BasedOn="{StaticResource NordSourceBadge}">
          <Setter Property="Background" Value="#3A301B"/>
          <Setter Property="BorderBrush" Value="#CFA95C"/>
      </Style>
      <Style x:Key="NordMvpSourceBadge" TargetType="Border" BasedOn="{StaticResource NordSourceBadge}">
          <Setter Property="Background" Value="#173A4C"/>
          <Setter Property="BorderBrush" Value="#71C5E2"/>
      </Style>
      <Style x:Key="NordPersonalSourceBadge" TargetType="Border" BasedOn="{StaticResource NordSourceBadge}">
          <Setter Property="Background" Value="#34233F"/>
          <Setter Property="BorderBrush" Value="#B98DCD"/>
      </Style>
      <Style x:Key="NordReaderBackButton" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
          <Setter Property="MinWidth" Value="100"/>
          <Setter Property="Height" Value="34"/>
          <Setter Property="Padding" Value="12,4"/>
          <Setter Property="Background" Value="#263845"/>
          <Setter Property="BorderBrush" Value="#607C8B"/>
      </Style>
      <Style x:Key="NordReaderFavoriteButton" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
          <Setter Property="MinWidth" Value="180"/>
          <Setter Property="Height" Value="34"/>
          <Setter Property="Padding" Value="12,4"/>
          <Setter Property="Background" Value="#433A23"/>
          <Setter Property="BorderBrush" Value="#B59A55"/>
      </Style>
      <Style x:Key="NordReaderTitle" TargetType="TextBlock" BasedOn="{StaticResource NordArticleTitle}">
          <Setter Property="FontSize" Value="32"/>
          <Setter Property="FontWeight" Value="Bold"/>
          <Setter Property="Margin" Value="0,0,0,2"/>
      </Style>
      <Style x:Key="NordReaderSummary" TargetType="TextBlock">
          <Setter Property="Foreground" Value="#D6CABB"/>
          <Setter Property="FontSize" Value="16"/>
          <Setter Property="FontStyle" Value="Italic"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="LineHeight" Value="25"/>
          <Setter Property="Margin" Value="0,4,0,22"/>
      </Style>
      <Style x:Key="NordReaderContent" TargetType="TextBlock">
          <Setter Property="Foreground" Value="#E1E6E9"/>
          <Setter Property="FontSize" Value="16"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="LineHeight" Value="27"/>
      </Style>
      <Style x:Key="NordRelatedArticleButton" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
          <Setter Property="Height" Value="42"/>
          <Setter Property="Padding" Value="12,0"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
          <Setter Property="Background" Value="#162733"/>
          <Setter Property="BorderBrush" Value="#415F70"/>
      </Style>
      <Style x:Key="NordEmptyState" TargetType="Border" BasedOn="{StaticResource NordPanelStyle}">
          <Setter Property="Background" Value="#101E29"/>
          <Setter Property="BorderBrush" Value="#6E98AA"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="Padding" Value="46,40"/>
          <Setter Property="Margin" Value="4"/>
          <Setter Property="CornerRadius" Value="10"/>
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#020609" BlurRadius="14" ShadowDepth="3" Opacity="0.42"/></Setter.Value></Setter>
      </Style>
</ResourceDictionary>
