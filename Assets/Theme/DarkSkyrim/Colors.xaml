<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Skyrim palette: northern stone, aged silver and moonlit blue. -->
    <Color x:Key="NordVoidColor">#090D12</Color>
    <Color x:Key="NordStoneColor">#111923</Color>
    <Color x:Key="NordPanelColor">#151F2A</Color>
    <Color x:Key="NordRaisedColor">#1B2834</Color>
    <Color x:Key="NordHoverColor">#223746</Color>
    <Color x:Key="NordPressedColor">#0E637E</Color>
    <Color x:Key="NordSilverColor">#B8C6CD</Color>
    <Color x:Key="NordMutedSilverColor">#748695</Color>
    <Color x:Key="NordBlueColor">#69C9E8</Color>
    <Color x:Key="NordBlueGlowColor">#A7E9FA</Color>
    <Color x:Key="NordDisabledColor">#45515A</Color>
    <Color x:Key="NordDangerColor">#C16B70</Color>

    <SolidColorBrush x:Key="NordVoidBrush" Color="{StaticResource NordVoidColor}"/>
    <SolidColorBrush x:Key="NordStoneBrush" Color="{StaticResource NordStoneColor}"/>
    <SolidColorBrush x:Key="NordPanelBrush" Color="{StaticResource NordPanelColor}"/>
    <SolidColorBrush x:Key="NordRaisedBrush" Color="{StaticResource NordRaisedColor}"/>
    <SolidColorBrush x:Key="NordHoverBrush" Color="{StaticResource NordHoverColor}"/>
    <SolidColorBrush x:Key="NordPressedBrush" Color="{StaticResource NordPressedColor}"/>
    <SolidColorBrush x:Key="NordSilverBrush" Color="{StaticResource NordSilverColor}"/>
    <SolidColorBrush x:Key="NordMutedSilverBrush" Color="{StaticResource NordMutedSilverColor}"/>
    <SolidColorBrush x:Key="NordBlueBrush" Color="{StaticResource NordBlueColor}"/>
    <SolidColorBrush x:Key="NordBlueGlowBrush" Color="{StaticResource NordBlueGlowColor}"/>
    <SolidColorBrush x:Key="NordDisabledBrush" Color="{StaticResource NordDisabledColor}"/>
    <SolidColorBrush x:Key="NordDangerBrush" Color="{StaticResource NordDangerColor}"/>

    <FontFamily x:Key="NordDisplayFont">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="NordBodyFont">Segoe UI</FontFamily>
    <Thickness x:Key="NordThinBorder">1</Thickness>
    <CornerRadius x:Key="NordCornerRadius">4</CornerRadius>
</ResourceDictionary>
