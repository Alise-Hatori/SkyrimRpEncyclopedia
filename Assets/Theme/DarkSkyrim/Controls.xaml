<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ImageBrush x:Key="NordStoneTextureBrush"
                ImageSource="/Assets/Theme/DarkSkyrim/nordic-stone-texture.png"
                Stretch="UniformToFill" Opacity="0.16"/>
    <!-- Vector tile brushes: seamless at any DPI and usable without the PNG texture. -->
    <DrawingBrush x:Key="NordRunePatternBrush" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Viewbox="0,0,48,48" ViewboxUnits="Absolute" Opacity="0.20">
        <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="{StaticResource NordBlueBrush}" Geometry="M4,4 L20,4 12,12 20,20 4,20 12,12z M28,28 L44,28 36,36 44,44 28,44 36,36z"/></DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="NordFrostPatternBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Viewbox="0,0,32,32" ViewboxUnits="Absolute" Opacity="0.12">
        <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="{StaticResource NordSilverBrush}" Geometry="M0,1 L1,0 2,1 1,2z M16,15 L17,14 18,15 17,16z M30,29 L31,28 32,29 31,30z"/></DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="NordPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NordPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordMutedSilverBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource NordCornerRadius}"/>
    </Style>

    <Style x:Key="NordNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource NordBodyFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <Border.RenderTransform><ScaleTransform x:Name="NavScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Grid>
                            <!-- Shared realistic metal backing: the content's vector symbol remains crisp on top. -->
                            <Image Source="/Assets/Theme/NordicArchive/Images/nav-medallion.png" Width="32" Height="32" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NordHoverBrush}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource NordBlueBrush}"/><Setter Property="Foreground" Value="{StaticResource NordBlueGlowBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NordPressedBrush}"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource NordBlueGlowBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/><Setter Property="Foreground" Value="{StaticResource NordDisabledBrush}"/></Trigger>
                        <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.10"/><DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.10"/></Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10"/><DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10"/></Storyboard></BeginStoryboard></EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Apply this style to the currently active navigation command. -->
    <Style x:Key="NordSelectedNavButton" TargetType="Button" BasedOn="{StaticResource NordNavButton}">
        <Setter Property="Background" Value="{StaticResource NordHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordBlueBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NordBlueGlowBrush}"/>
    </Style>

    <!-- Action buttons intentionally do not inherit NordNavButton: the navigation medallion belongs only in the sidebar. -->
    <Style x:Key="NordActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NordRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordMutedSilverBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource NordBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <Border.RenderTransform><ScaleTransform x:Name="ActionScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="{StaticResource NordHoverBrush}"/><Setter TargetName="ActionBorder" Property="BorderBrush" Value="{StaticResource NordBlueBrush}"/><Setter Property="Foreground" Value="{StaticResource NordBlueGlowBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="{StaticResource NordPressedBrush}"/><Setter TargetName="ActionBorder" Property="BorderBrush" Value="{StaticResource NordBlueGlowBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionBorder" Property="Opacity" Value="0.42"/><Setter Property="Foreground" Value="{StaticResource NordDisabledBrush}"/></Trigger>
                        <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.10"/><DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.10"/></Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10"/><DoubleAnimation Storyboard.TargetName="ActionScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10"/></Storyboard></BeginStoryboard></EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NordPrimaryButton" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
        <Setter Property="Background" Value="#17485C"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordBlueBrush}"/>
    </Style>

    <Style x:Key="NordSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0B1219"/>
        <Setter Property="Foreground" Value="{StaticResource NordSilverBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource NordBlueGlowBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NordMutedSilverBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource NordBodyFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource NordBlueBrush}"/><Setter TargetName="Border" Property="Background" Value="#101C26"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NordScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="#0B1016"/>
        <Setter Property="Foreground" Value="{StaticResource NordMutedSilverBrush}"/>
    </Style>
</ResourceDictionary>
