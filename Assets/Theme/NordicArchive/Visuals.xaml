<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Illustrated assets for the Nordic Archive dashboard. All text remains native WPF for DPI and accessibility. -->
    <ImageBrush x:Key="ArchiveHeroBrush" ImageSource="/Assets/Theme/NordicArchive/Images/hero-mountains.png" Stretch="UniformToFill"/>
    <ImageBrush x:Key="ArchiveCharactersBrush" ImageSource="/Assets/Theme/NordicArchive/Images/card-characters.png" Stretch="UniformToFill"/>
    <ImageBrush x:Key="ArchiveLoreBrush" ImageSource="/Assets/Theme/NordicArchive/Images/card-lore.png" Stretch="UniformToFill"/>
    <ImageBrush x:Key="ArchiveFactionsBrush" ImageSource="/Assets/Theme/NordicArchive/Images/card-factions.png" Stretch="UniformToFill"/>
    <ImageBrush x:Key="ArchiveLocationsBrush" ImageSource="/Assets/Theme/NordicArchive/Images/card-locations.png" Stretch="UniformToFill"/>
    <ImageBrush x:Key="ArchiveRulesBrush" ImageSource="/Assets/Theme/NordicArchive/Images/card-rules.png" Stretch="UniformToFill"/>
    <ImageBrush x:Key="ArchiveGodsBrush" ImageSource="/Assets/Theme/NordicArchive/Images/card-gods.png" Stretch="UniformToFill"/>
    <ImageBrush x:Key="ArchiveMagicBrush" ImageSource="/Assets/Theme/NordicArchive/Images/card-magic.png" Stretch="UniformToFill"/>

    <Style x:Key="ArchiveHeroFrame" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ArchiveHeroBrush}"/>
        <Setter Property="BorderBrush" Value="#B99768"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Height" Value="300"/>
    </Style>
    <Style x:Key="ArchiveCategoryCard" TargetType="Button" BasedOn="{StaticResource NordNavButton}">
        <Setter Property="Width" Value="170"/>
        <Setter Property="Height" Value="188"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="#A98051" BorderThickness="1" CornerRadius="4">
                        <Border.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Grid>
                            <Rectangle Fill="#21000000"/>
                            <ContentPresenter VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F1D29C"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/><Setter TargetName="Frame" Property="Effect"><Setter.Value><DropShadowEffect Color="#C99A55" BlurRadius="13" ShadowDepth="0" Opacity="0.65"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.40"/></Trigger>
                        <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ArchiveCategoryCaption" TargetType="Border">
        <Setter Property="Background" Value="#E8D6B48A"/>
        <Setter Property="BorderBrush" Value="#D8B77E"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="Padding" Value="9,7"/>
    </Style>
    <Style x:Key="ArchiveQuickAction" TargetType="Button" BasedOn="{StaticResource NordActionButton}">
        <Setter Property="Background" Value="#172633"/>
        <Setter Property="BorderBrush" Value="#4A6978"/>
        <Setter Property="Padding" Value="13,8"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
</ResourceDictionary>
