<Window x:Class="SkyrimRpEncyclopedia.ArticleNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки"
        Width="780"
        Height="580"
        MinWidth="650"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NordVoidBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/ThemeDefaults.xaml"/>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Style="{StaticResource DialogHeading}"/>
            <TextBlock Text="Личные заметки хранятся только в вашей базе."
                       Style="{StaticResource DialogLead}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NotesListBox" DisplayMemberPath="Content"
                     SelectionChanged="NotesListBox_SelectionChanged"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Тип заметки" Style="{StaticResource DialogFieldLabel}"/>
                <ComboBox x:Name="NoteTypeBox" Margin="0,5,0,12">
                    <ComboBoxItem Content="Private"/>
                    <ComboBoxItem Content="Public"/>
                </ComboBox>
                <TextBlock Text="Текст" Style="{StaticResource DialogFieldLabel}"/>
                <TextBox x:Name="NoteContentBox" Height="230" Margin="0,5,0,14"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Новая" Style="{StaticResource DialogSecondaryButton}" Click="NewNote_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource DialogPrimaryButton}" Margin="10,0,0,0" Click="SaveNote_Click"/>
                    <Button Content="Удалить" Style="{StaticResource DialogDangerButton}" Margin="10,0,0,0" Click="DeleteNote_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Button Grid.Row="2" Content="Закрыть" Style="{StaticResource DialogSecondaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Close_Click"/>
    </Grid>
</Window>
