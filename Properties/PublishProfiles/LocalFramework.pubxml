<Project>
  <PropertyGroup>
    <!-- Local, framework-dependent folder; never embeds databases or a WebView2 runtime. -->
    <Configuration>Release</Configuration>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Update="RELEASE_1_0.md;RELEASE_CHECKLIST.md;THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="METADATA_QA.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="LICENSES\**\*" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Scripts\Test-ReleasePackage.ps1" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="**\*.db;**\*.db-wal;**\*.db-shm;**\*.log;Tests\**\*" />
    <None Update="**\*.db;**\*.db-wal;**\*.db-shm;**\*.log;Tests\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="ValidateLocalFrameworkPublishAssets" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)Microsoft.Data.Sqlite.dll')" Text="Incomplete publish: Microsoft.Data.Sqlite.dll is missing. Do not distribute this directory." />
    <Error Condition="'%(ResolvedFileToPublish.CopyToPublishDirectory)' != 'Never' and !Exists('$(PublishDir)%(ResolvedFileToPublish.RelativePath)')" Text="Incomplete publish: %(ResolvedFileToPublish.RelativePath) is missing." />
  </Target>
</Project>
