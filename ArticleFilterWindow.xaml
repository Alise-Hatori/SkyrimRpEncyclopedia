<Window x:Class="SkyrimRpEncyclopedia.ArticleFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтры материалов"
        Width="720"
        Height="590"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NordVoidBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/ThemeDefaults.xaml"/>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Фильтры материалов" Style="{StaticResource DialogHeading}"/>
            <TextBlock Text="Все выбранные теги и флаги должны присутствовать у материала." Style="{StaticResource DialogLead}"/>
            <TextBlock Text="Значения подписаны источником. Условия разных источников не объединяются в одну статью." Style="{StaticResource DialogLead}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Источник" Style="{StaticResource DialogFieldLabel}"/>
                <ComboBox x:Name="SourceBox" Margin="0,5,0,0">
                    <ComboBoxItem Content="Все материалы"/>
                    <ComboBoxItem Content="Только официальные"/>
                    <ComboBoxItem Content="Только личные"/>
                    <ComboBoxItem Content="Только Knowledge"/>
                    <ComboBoxItem Content="Только RP-правила"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Категория" Style="{StaticResource DialogFieldLabel}"/>
                <ComboBox x:Name="CategoryBox" DisplayMemberPath="DisplayName" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Теги" Style="{StaticResource DialogFieldLabel}"/>
                <ListBox x:Name="TagsListBox" SelectionMode="Multiple" DisplayMemberPath="DisplayName"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Флаги" Style="{StaticResource DialogFieldLabel}"/>
                <ListBox x:Name="FlagsListBox" SelectionMode="Multiple" DisplayMemberPath="DisplayName"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сбросить" Style="{StaticResource DialogSecondaryButton}" Click="Reset_Click"/>
            <Button Content="Применить" Style="{StaticResource DialogPrimaryButton}" Margin="10,0,0,0" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
