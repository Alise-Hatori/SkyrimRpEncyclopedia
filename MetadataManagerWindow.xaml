<Window x:Class="SkyrimRpEncyclopedia.MetadataManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Управление метаданными" Width="1240" Height="860" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterOwner" Background="{StaticResource NordVoidBrush}">
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/MetadataStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="MetadataVisibility"/>
  <Style x:Key="MetadataInput" TargetType="TextBox" BasedOn="{StaticResource NordSearchBox}">
   <Setter Property="Padding" Value="11,7"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/>
  </Style>
  <Style x:Key="MetadataItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="#12212E" BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#203A4C"/><Setter TargetName="Row" Property="BorderBrush" Value="#93C9DF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#628A9E"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#D1B67B"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="MetadataTabContent">
   <Grid Margin="0,18,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.43*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.57*"/></Grid.ColumnDefinitions>
    <Border Background="#101B25" BorderBrush="#293F50" BorderThickness="1" CornerRadius="5" Padding="16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="{StaticResource NordSilverBrush}" Margin="0,0,0,12"/>
      <StackPanel Grid.Row="1"><TextBlock Text="Поиск по названию и описанию" Foreground="#8FAABB" FontSize="11" Margin="0,0,0,6"/><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataInput}" ToolTip="Поиск по названию и описанию" AutomationProperties.Name="Поиск метаданных"/></StackPanel>
      <StackPanel Grid.Row="2" Margin="0,9,0,12"><TextBlock Text="Чтение справочника…" Foreground="#A1CADB" FontSize="11" Visibility="{Binding IsBusy,Converter={StaticResource MetadataVisibility}}"/><TextBlock Text="{Binding VisibleLabel}" Foreground="{StaticResource NordMutedSilverBrush}" FontSize="11"/></StackPanel>
      <Grid Grid.Row="3">
       <ListBox ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow,Mode=TwoWay}" ItemContainerStyle="{StaticResource MetadataItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Элементы метаданных">
        <ListBox.ItemTemplate><DataTemplate><Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Image Source="{Binding Image}" Width="25" Height="25" VerticalAlignment="Top" Margin="0,2,9,0"/>
         <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="#E5EDF2" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding Hint}" Foreground="#93AAB8" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Hint}"/>
          <TextBlock Text="Системный элемент" Foreground="#94C5D8" FontSize="10" Margin="0,5,0,0" Visibility="{Binding IsSystem,Converter={StaticResource MetadataVisibility}}"/>
         </StackPanel>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <StackPanel VerticalAlignment="Center" Margin="18" Visibility="{Binding IsEmpty,Converter={StaticResource MetadataVisibility}}">
        <Image Source="{StaticResource MetadataIcon_parchment}" Width="44" Height="44" Opacity="0.45" Margin="0,0,0,16"/>
        <TextBlock Text="{Binding EmptyTitle}" TextAlignment="Center" FontSize="18" Foreground="#B9D1DD" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding EmptyHint}" TextAlignment="Center" Foreground="{StaticResource NordMutedSilverBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
       </StackPanel>
      </Grid>
      <Button Grid.Row="4" Content="Готовые наборы" Command="{Binding PresetsCommand}" Style="{StaticResource DialogSecondaryButton}" Padding="14,0" Margin="0,15,0,0" HorizontalAlignment="Left" Visibility="{Binding HasPresets,Converter={StaticResource MetadataVisibility}}"/>
     </Grid>
    </Border>
    <Border Grid.Column="2" Background="#14232F" BorderBrush="#304B5E" BorderThickness="1" CornerRadius="5" Padding="22">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding ModeLabel}" FontSize="10" Foreground="#99CADD" Margin="0,0,0,14"/>
       <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="54" Height="60" Background="#1C3343" BorderBrush="#426378" BorderThickness="1" CornerRadius="5" VerticalAlignment="Top"><Image Source="{Binding PreviewImage}" Width="32" Height="32"/></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding PreviewTitle}" FontSize="22" Foreground="#E9E4D6" TextWrapping="Wrap" MaxHeight="65" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding PreviewDescription}" Foreground="#9CB3C1" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" MaxHeight="50" TextTrimming="CharacterEllipsis"/></StackPanel>
       </Grid>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel IsEnabled="{Binding CanEdit}">
        <TextBlock Text="Название" Style="{StaticResource DialogFieldLabel}"/>
        <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataInput}" AutomationProperties.Name="Название элемента"/>
        <StackPanel Visibility="{Binding HasDescription,Converter={StaticResource MetadataVisibility}}" Margin="0,16,0,0">
         <TextBlock Text="Описание" Style="{StaticResource DialogFieldLabel}"/>
         <TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataInput}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Описание элемента"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsFlag,Converter={StaticResource MetadataVisibility}}" Margin="0,16,0,0">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Пиктограмма" Style="{StaticResource DialogFieldLabel}"/>
           <ComboBox ItemsSource="{Binding IconOptions}" SelectedItem="{Binding SelectedIcon,Mode=TwoWay}" MinHeight="40" AutomationProperties.Name="Пиктограмма флага"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Image}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Title}" FontSize="12"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Цвет · HEX" Style="{StaticResource DialogFieldLabel}"/><TextBox Text="{Binding Color,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MetadataInput}" AutomationProperties.Name="Цвет флага"/></StackPanel>
         </Grid>
        </StackPanel>
        <TextBlock Text="{Binding StorageHint}" Foreground="#8FA6B5" FontSize="11" TextWrapping="Wrap" Margin="0,17,0,16"/>
       </StackPanel>
      </ScrollViewer>
      <WrapPanel Grid.Row="2" Margin="0,18,0,0">
       <Button Content="Новый" Command="{Binding NewCommand}" Style="{StaticResource DialogSecondaryButton}" Padding="12,0" MinWidth="78" Margin="0,0,8,8"/>
       <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource DialogPrimaryButton}" Padding="12,0" MinWidth="102" Margin="0,0,8,8"/>
       <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource DialogSecondaryButton}" Padding="12,0" MinWidth="78" Margin="0,0,8,8"/>
       <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DialogDangerButton}" Padding="12,0" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#AAD5E5" FontSize="12" TextWrapping="Wrap" MaxHeight="64" AutomationProperties.LiveSetting="Polite"/>
     </Grid>
    </Border>
   </Grid>
  </DataTemplate>
 </ResourceDictionary></Window.Resources>
 <Grid Margin="28,24,28,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="ЛИЧНЫЙ АРХИВ  /  КАТАЛОГ" Foreground="#82ABBF" FontSize="10" Margin="0,0,0,9"/><TextBlock Text="Управление метаданными" FontSize="29" Foreground="#E6E1D2" FontFamily="{StaticResource NordDisplayFont}"/><TextBlock Text="Упорядочивайте знания — без изменения содержимого корпуса." Foreground="#98ADBC" FontSize="12" TextWrapping="Wrap" Margin="0,7,15,0"/></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Tabs[0].CountLabel}" FontSize="11" Foreground="#9FB9C8" Margin="0,2"/><TextBlock Text="{Binding Tabs[1].CountLabel}" FontSize="11" Foreground="#9FB9C8" Margin="0,2"/><TextBlock Text="{Binding Tabs[2].CountLabel}" FontSize="11" Foreground="#9FB9C8" Margin="0,2"/></StackPanel>
  </Grid>
  <TabControl x:Name="MetadataTabs" Grid.Row="1" ItemsSource="{Binding Tabs}" ContentTemplate="{StaticResource MetadataTabContent}" SelectionChanged="MetadataTabs_SelectionChanged" BorderThickness="0" Background="Transparent"><TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding CountLabel}" FontSize="14" Padding="4,2"/></DataTemplate></TabControl.ItemTemplate></TabControl>
  <Grid Grid.Row="2" Margin="0,17,0,0"><TextBlock Text="Пользовательские справочники · системные элементы защищены от удаления" Foreground="#7896A8" FontSize="10" VerticalAlignment="Center"/><Button Content="Закрыть" Click="Close_Click" Style="{StaticResource DialogSecondaryButton}" Padding="14,0" HorizontalAlignment="Right"/></Grid>
 </Grid>
</Window>
