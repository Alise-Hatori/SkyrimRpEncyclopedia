<Window x:Class="SkyrimRpEncyclopedia.ArticleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание статьи"
        Width="850"
        Height="750"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NordVoidBrush}">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/ThemeDefaults.xaml"/>
            <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/DialogStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <Style x:Key="InputBox"
               TargetType="Control">

            <Setter Property="Background"
                    Value="{StaticResource NordRaisedBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource NordSilverBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource NordMutedSilverBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

        </Style>

        <Style x:Key="Label"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource NordMutedSilverBrush}"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Margin"
                    Value="0,12,0,5"/>

        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>

            <RowDefinition Height="65"/>

        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="НОВАЯ СТАТЬЯ" Style="{StaticResource DialogHeading}" FontSize="28"/>

                <TextBlock Text="Личный материал энциклопедии" Style="{StaticResource DialogLead}" Margin="0,5,0,20"/>


                <TextBlock Text="Название"
                           Style="{StaticResource Label}"/>

                <TextBox x:Name="TitleBox"
                         Height="40"
                         Padding="10"
                         Style="{StaticResource InputBox}"/>


                <TextBlock Text="Категория"
                           Style="{StaticResource Label}"/>

                <ComboBox x:Name="CategoryBox"
                          Height="40"
                          Padding="8"
                          Background="{StaticResource NordRaisedBrush}"
                          Foreground="{StaticResource NordSilverBrush}">

                    <ComboBoxItem Content="Лор Skyrim"/>
                    <ComboBoxItem Content="Фракции"/>
                    <ComboBoxItem Content="Локации"/>
                    <ComboBoxItem Content="Персонажи"/>
                    <ComboBoxItem Content="Правила RP"/>
                    <ComboBoxItem Content="Боги и даэдра"/>
                    <ComboBoxItem Content="Магия"/>
                    <ComboBoxItem Content="Оружие"/>
                    <ComboBoxItem Content="Другое"/>

                </ComboBox>


                <TextBlock Text="Флаги"
                           Style="{StaticResource Label}"/>

                <TextBox x:Name="FlagsBox"
                         Height="40"
                         Padding="10"
                         Style="{StaticResource InputBox}"
                         ToolTip="Например: RP PROJECT, IMPORTANT, EVENT"/>

                <Button Content="Выбрать теги и флаги"
                        Style="{StaticResource DialogSecondaryButton}"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Click="SelectMetadata_Click"/>


                <TextBlock Text="Теги"
                           Style="{StaticResource Label}"/>

                <TextBox x:Name="TagsBox"
                         Height="40"
                         Padding="10"
                         Style="{StaticResource InputBox}"
                         ToolTip="Например: Братство, Скайрим, Хелген"/>


                <TextBlock Text="Краткая сводка"
                           Style="{StaticResource Label}"/>

                <TextBox x:Name="SummaryBox"
                         Height="80"
                         Padding="10"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource InputBox}"/>


                <TextBlock Text="Основной текст"
                           Style="{StaticResource Label}"/>

                <TextBox x:Name="ContentBox"
                         MinHeight="250"
                         Padding="10"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource InputBox}"/>

            </StackPanel>

        </ScrollViewer>


        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <Button Content="Отмена"
                    Style="{StaticResource DialogSecondaryButton}"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Сохранить"
                    Style="{StaticResource DialogPrimaryButton}"
                    MinWidth="150"
                    FontWeight="SemiBold"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>
