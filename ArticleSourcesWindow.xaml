<Window x:Class="SkyrimRpEncyclopedia.ArticleSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Источники статьи"
        Width="850"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NordVoidBrush}"
        Foreground="{StaticResource NordSilverBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/ThemeDefaults.xaml"/>
                <ResourceDictionary Source="/Assets/Theme/DarkSkyrim/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">

            <TextBlock x:Name="ArticleTitleText"
                       Style="{StaticResource DialogHeading}"
                       Text="Источники статьи"/>

            <TextBlock Text="Внешние материалы, подтверждающие содержание статьи"
                       Style="{StaticResource DialogLead}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Список источников -->
        <ListBox x:Name="SourcesList"
                 Grid.Row="1"
                 BorderThickness="0">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="{StaticResource NordPanelBrush}"
                            BorderBrush="{StaticResource NordMutedSilverBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="{Binding Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding SourceType}"
                                           Foreground="{StaticResource NordMutedSilverBrush}"
                                           Margin="0,3,0,0"/>

                                <TextBlock Text="{Binding Author}"
                                           Foreground="{StaticResource NordMutedSilverBrush}"
                                           Margin="0,2,0,0"/>

                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                                <TextBlock Text="{Binding Url}"
                                           Foreground="{StaticResource NordBlueBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0">

                                <Button Content="Открыть"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        Click="OpenSource_Click"
                                        Tag="{Binding}"
                                        Padding="10,6"
                                        Margin="0,0,6,0"/>

                                <Button Content="Изменить"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        Click="EditSource_Click"
                                        Tag="{Binding}"
                                        Padding="10,6"
                                        Margin="0,0,6,0"/>

                                <Button Content="Удалить"
                                        Style="{StaticResource DialogDangerButton}"
                                        Click="DeleteSource_Click"
                                        Tag="{Binding}"
                                        Padding="10,6"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Добавить источник"
                    Style="{StaticResource DialogPrimaryButton}"
                    Click="AddSource_Click"
                    Padding="14,8"
                    Margin="0,0,8,0"/>

            <Button Content="Закрыть"
                    Style="{StaticResource DialogSecondaryButton}"
                    Click="Close_Click"
                    Padding="14,8"/>

        </StackPanel>

    </Grid>

</Window>
